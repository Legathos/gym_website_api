<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.4.xsd">
    <changeSet id="fix_exercise_id_fk" author="system">
        <!-- Drop the incorrect foreign key constraint -->
        <dropForeignKeyConstraint baseTableName="set_tracking" constraintName="exercise_id_fk"/>
        
        <!-- Add the correct foreign key constraint -->
        <addForeignKeyConstraint baseTableName="set_tracking" baseColumnNames="exercise_id"
                                 constraintName="exercise_id_fk"
                                 referencedTableName="exercises" referencedColumnNames="id"
                                 onDelete="CASCADE" onUpdate="CASCADE"/>
    </changeSet>
</databaseChangeLog>